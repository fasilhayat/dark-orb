# BattleArena environment configuration
# Copy this file to .env and set the environment you want.
# The .env file is NOT committed to source control.
#
# Available environments:
#   localdev  - DB + API in Docker, ports exposed. Demo runs locally (make demo-local).
#   dev       - DB + API + Demo all in Docker, ports exposed. Demo via make demo.
#   test      - DB + API + Demo in Docker, no host ports.
#   preprod   - DB + API only, no host ports.
#   prod      - DB + API only, no host ports. (default when no .env file)
#
# Usage:
#   make up              # starts DB + API for the configured ENV
#   make demo            # runs demo container (dev/test only)
#   make demo-local      # runs demo locally (localdev)
#   make up ENV=dev      # one-off override without .env file

ENV=localdev
