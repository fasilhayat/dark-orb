<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BattleArena.Gui.Views"
             x:Class="BattleArena.Gui.Views.CharacterCard"
             Width="280" MinHeight="120">
  <UserControl.Resources>
    <views:DoubleToWidthConverter x:Key="WidthConv" />
  </UserControl.Resources>

  <Border BorderBrush="{Binding BorderColor}" BorderThickness="2" CornerRadius="4"
          Background="#1a1a2e" Padding="8">
    <StackPanel Spacing="3">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <TextBlock Text="{Binding ActiveIndicator}" Foreground="#88bbff" FontSize="13" />
        <TextBlock Text="{Binding Name}" Foreground="{Binding NameColor}"
                   FontWeight="Bold" FontSize="14" />
      </StackPanel>
      <TextBlock Text="{Binding CurrentWeapon}" Foreground="#888"
                 FontStyle="Italic" FontSize="11" />
      <TextBlock Text="{Binding InfoLine}" Foreground="#888" FontSize="11" />

      <!-- TM bar -->
      <Border BorderBrush="#333" BorderThickness="1" CornerRadius="3" Background="#111" Height="18">
        <Grid>
          <Border HorizontalAlignment="Left" CornerRadius="2"
                  Width="{Binding TmFraction, Converter={StaticResource WidthConv}}"
                  Background="#00bfff" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
              <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
              <ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0" Fill="#00000020" Width="1" HorizontalAlignment="Right" />
            <Rectangle Grid.Column="1" Fill="#00000020" Width="1" HorizontalAlignment="Right" />
            <Rectangle Grid.Column="2" Fill="#00000020" Width="1" HorizontalAlignment="Right" />
            <Rectangle Grid.Column="3" Fill="#00000020" Width="1" HorizontalAlignment="Right" />
            <Rectangle Grid.Column="4" Fill="#00000020" Width="1" HorizontalAlignment="Right" />
            <Rectangle Grid.Column="5" Fill="#00000020" Width="1" HorizontalAlignment="Right" />
            <Rectangle Grid.Column="6" Fill="#00000020" Width="1" HorizontalAlignment="Right" />
            <Rectangle Grid.Column="7" Fill="#00000020" Width="1" HorizontalAlignment="Right" />
            <Rectangle Grid.Column="8" Fill="#00000020" Width="1" HorizontalAlignment="Right" />
          </Grid>
          <TextBlock Text="{Binding TmDisplay}" Foreground="White" FontSize="10"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- Mana bar -->
      <Border BorderBrush="#333" BorderThickness="1" CornerRadius="3" Background="#111" Height="18">
        <Grid>
          <Border HorizontalAlignment="Left" CornerRadius="2"
                  Width="{Binding ManaFraction, Converter={StaticResource WidthConv}}"
                  Background="{Binding ManaBarColor}" />
          <TextBlock Text="{Binding ManaDisplay}" Foreground="White" FontSize="10"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- HP bar -->
      <Border BorderBrush="#333" BorderThickness="1" CornerRadius="3" Background="#111" Height="22">
        <Grid>
          <Border HorizontalAlignment="Left" CornerRadius="2"
                  Width="{Binding HpFraction, Converter={StaticResource WidthConv}}"
                  Background="{Binding HpBarColor}" />
          <TextBlock Text="{Binding HpDisplay}" Foreground="White" FontSize="11" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <Border IsVisible="{Binding IsDead}" Background="#80000040" CornerRadius="2" Margin="0">
        <TextBlock Text="{Binding DeadLabel}" Foreground="#ff4444" FontWeight="Bold"
                   FontSize="16" HorizontalAlignment="Center" />
      </Border>
    </StackPanel>
  </Border>
</UserControl>
