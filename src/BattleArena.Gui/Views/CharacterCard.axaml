<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BattleArena.Gui.Views"
             x:Class="BattleArena.Gui.Views.CharacterCard"
              Width="300" MinHeight="160">
  <UserControl.Resources>
    <views:DoubleToGridLengthConverter x:Key="GridLengthConv" />
  </UserControl.Resources>

  <Border BorderBrush="{Binding BorderColor}" BorderThickness="2" CornerRadius="4"
          Background="#1a1a2e" Padding="8" MinHeight="0">
    <Grid>
      <!-- Content layer -->
      <StackPanel Spacing="4">

        <!-- Top row: portrait + name / info -->
        <Grid ColumnDefinitions="112,*">
          <!-- Portrait (100×133, 3:4 ratio) -->
          <Border Grid.Column="0" Width="100" Height="133"
                  BorderBrush="{Binding BorderColor}" BorderThickness="1"
                  CornerRadius="4" Background="#111" Margin="0,0,12,0"
                  ClipToBounds="True">
            <Grid>
              <!-- Fallback: initial letter when no portrait -->
              <Border Background="#16162a" CornerRadius="3"
                      IsVisible="{Binding PortraitIsNull}" />
              <TextBlock Text="{Binding PortraitInitial}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="{Binding NameColor}" FontSize="42" FontWeight="Bold"
                         Opacity="0.6"
                         IsVisible="{Binding PortraitIsNull}" />
              <!-- Actual portrait -->
              <Image Source="{Binding Portrait}" Stretch="UniformToFill"
                     IsVisible="{Binding HasPortrait}" />
            </Grid>
          </Border>

          <!-- Name / weapon / info -->
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding ActiveIndicator}" Foreground="#88bbff" FontSize="13" />
              <TextBlock Text="{Binding Name}" Foreground="{Binding NameColor}"
                         FontWeight="Bold" FontSize="14" />
            </StackPanel>
            <TextBlock Text="{Binding CurrentWeapon}" Foreground="#888"
                       FontStyle="Italic" FontSize="11" />
            <TextBlock Text="{Binding InfoLine}" Foreground="#888" FontSize="11" />
          </StackPanel>
        </Grid>

        <!-- TM bar — piped segments -->
        <Border BorderBrush="#333" BorderThickness="1" CornerRadius="3" Background="#111" Height="18" ClipToBounds="True">
          <Grid>
            <ItemsControl ItemsSource="{Binding TmPipes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="3" Margin="0,0,2,0" Background="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding TmDisplay}" Foreground="White" FontSize="11" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Mana bar -->
        <Border BorderBrush="#333" BorderThickness="1" CornerRadius="3" Background="#111" Height="18">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding ManaFraction, Converter={StaticResource GridLengthConv}}" />
              <ColumnDefinition Width="{Binding ManaEmptyFraction, Converter={StaticResource GridLengthConv}}" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{Binding ManaBarColor}" CornerRadius="2" />
            <TextBlock Grid.ColumnSpan="2" Text="{Binding ManaDisplay}" Foreground="White"
                       FontSize="11" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- HP bar -->
        <Border BorderBrush="#333" BorderThickness="1" CornerRadius="3" Background="#111" Height="18">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="{Binding HpFraction, Converter={StaticResource GridLengthConv}}" />
              <ColumnDefinition Width="{Binding HpEmptyFraction, Converter={StaticResource GridLengthConv}}" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{Binding HpBarColor}" CornerRadius="2" />
            <TextBlock Grid.ColumnSpan="2" Text="{Binding HpDisplay}" Foreground="White"
                       FontSize="11" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>

      <!-- Overlay layer: death or status effects -->
      <Border IsVisible="{Binding HasStatusOverlay}" Background="#80000040" CornerRadius="2"
              VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="24">
        <TextBlock Text="{Binding StatusLine}" Foreground="#ff4444" FontWeight="Bold"
                   FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Grid>
  </Border>
</UserControl>
