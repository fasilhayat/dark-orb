<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BattleArena.Gui.Views"
             x:Class="BattleArena.Gui.Views.CharacterCard"
             Width="380" MinHeight="180">
  

  <Border BorderBrush="{Binding BorderColor}" BorderThickness="2" CornerRadius="4"
          Background="#1a1a2e" Padding="8" MinHeight="0">
    <Grid>
      <!-- Content layer -->
      <StackPanel Spacing="4">

        <!-- Top row: portrait + name / info / stats -->
        <Grid ColumnDefinitions="112,*">
          <!-- Portrait (100×133, 3:4 ratio) -->
          <Border Grid.Column="0" Width="100" Height="133"
                  BorderBrush="{Binding BorderColor}" BorderThickness="1"
                  CornerRadius="4" Background="#111" Margin="0,0,12,0"
                  ClipToBounds="True">
            <Grid>
              <!-- Fallback: initial letter when no portrait -->
              <Border Background="#16162a" CornerRadius="3"
                      IsVisible="{Binding PortraitIsNull}" />
              <TextBlock Text="{Binding PortraitInitial}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                          Foreground="{Binding NameColor}" FontSize="42" FontWeight="Bold"
                         Opacity="0.6"
                         IsVisible="{Binding PortraitIsNull}" />
              <!-- Actual portrait -->
              <Image Source="{Binding Portrait}" Stretch="UniformToFill"
                     IsVisible="{Binding HasPortrait}" />
            </Grid>
          </Border>

          <!-- Name / weapon / info / stats -->
          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="{Binding ActiveIndicator}" Foreground="#88bbff" FontSize="14" />
              <TextBlock Text="{Binding Name}" Foreground="{Binding NameColor}"
                         FontWeight="Bold" FontSize="15"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Text="{Binding CurrentWeapon}" Foreground="White"
                       FontStyle="Italic" FontSize="12" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Text="{Binding InfoLine}" Foreground="White"
                         FontSize="12" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding EffectsDisplay}" FontSize="12"
                         Foreground="{Binding EffectsColor}" FontStyle="Italic"
                         IsVisible="{Binding HasEffectsDisplay}"
                         VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>

            <!-- Stacked combat stats -->
            <Border Background="#16162a" CornerRadius="3" Padding="0,2" Margin="0,0,0,0">
              <StackPanel Spacing="1">
                <TextBlock FontSize="12" Foreground="#888">
                  <Run Text="Armor: "/><Run Text="{Binding ArmorLine}"/>
                </TextBlock>
                <TextBlock Text="{Binding StrikeLine}" FontSize="12" Foreground="#888" />
                <TextBlock Text="{Binding WeaponLine}" FontSize="12" Foreground="#888" />
                <TextBlock Text="{Binding ResistLine}" FontSize="12" Foreground="#888" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>

        <!-- TM bar — piped segments, scaled to fill width -->
        <Border BorderBrush="{Binding TmBorderBrush}" BorderThickness="1" CornerRadius="3" Background="#111" Height="20" ClipToBounds="True">
          <Grid>
            <Viewbox Stretch="Fill">
              <ItemsControl ItemsSource="{Binding TmPipes}" Height="20">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Width="3" Margin="0,0,2,0" Background="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Viewbox>
            <TextBlock Text="{Binding TmDisplay}" Foreground="White"
                       FontSize="12" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- Mana bar -->
        <Border BorderBrush="#333" BorderThickness="1" CornerRadius="3" Background="#111" Height="20" ClipToBounds="True">
          <Grid>
            <Border Background="#111" CornerRadius="2" />
            <Border Background="{Binding ManaBarColor}" CornerRadius="2"
                    RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="{Binding ManaFraction}" />
              </Border.RenderTransform>
            </Border>
            <TextBlock Text="{Binding ManaDisplay}" Foreground="White"
                       FontSize="12" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- HP bar -->
        <Border BorderBrush="#333" BorderThickness="1" CornerRadius="3" Background="#111" Height="20" ClipToBounds="True">
          <Grid>
            <Border Background="#111" CornerRadius="2" />
            <Border Background="{Binding HpBarColor}" CornerRadius="2"
                    RenderTransformOrigin="0,0.5">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="{Binding HpFraction}" />
              </Border.RenderTransform>
            </Border>
            <!-- Heal glow overlay: white bar positioned at the HP boundary, not the root -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding HealGlowStart, Converter={StaticResource GridLenConv}}" />
                <ColumnDefinition Width="{Binding HealGlowFraction, Converter={StaticResource GridLenConv}}" />
                <ColumnDefinition Width="{Binding HealGlowRemainder, Converter={StaticResource GridLenConv}}" />
              </Grid.ColumnDefinitions>
              <Border Grid.Column="1" Background="#ffffff" CornerRadius="2"
                      Opacity="{Binding HealGlowOpacity}" />
            </Grid>
            <TextBlock Text="{Binding HpDisplay}" Foreground="White"
                       FontSize="12" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </StackPanel>

      <!-- Overlay layer: death or status effects -->
      <Border IsVisible="{Binding HasStatusOverlay}" Background="#80000040" CornerRadius="2"
              VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="26">
        <TextBlock Text="{Binding StatusLine}" Foreground="#ff4444" FontWeight="Bold"
                   FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Grid>
  </Border>
</UserControl>
