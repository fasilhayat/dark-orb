<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BattleArena.Gui.Views"
        x:Class="BattleArena.Gui.Views.MainWindow"
        Title="BattleArena — Combat Simulation"
        Width="1200" Height="800" MinWidth="900" MinHeight="600"
        Background="#0d0d1a">
  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="8">

    <!-- Row 0: Header -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="***  BATTLE ARENA  —  COMBAT SIMULATION  ***"
                 Foreground="#00bfff" FontSize="18" FontWeight="Bold"
                 HorizontalAlignment="Center" Margin="0,4" />
      <TextBlock Foreground="#d4a017" FontSize="13" FontWeight="Bold"
                 HorizontalAlignment="Center"
                 Text="{Binding RoundHeader}" />
    </StackPanel>

    <!-- Row 1: Character cards side by side -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Margin="0,4">
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Heroes}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <views:CharacterCard DataContext="{Binding}" Margin="2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <Border Grid.Column="1" Width="3" Background="#333" Margin="8,0" />

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Enemies}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <views:CharacterCard DataContext="{Binding}" Margin="2" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Row 2: Combat log -->
    <Border Grid.Row="2" BorderBrush="#333" BorderThickness="1" CornerRadius="3"
            Background="#0a0a1a" Margin="0,4">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Grid.Row="0" Text="COMBAT LOG" Foreground="#888" FontSize="11"
                   FontWeight="Bold" Margin="6,2" />
        <ListBox Grid.Row="1" ItemsSource="{Binding CombatLog}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                         FontFamily="Consolas" FontSize="12"
                         TextWrapping="NoWrap" Margin="4,0" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <!-- Row 3: Control bar -->
    <Border Grid.Row="3" BorderBrush="#333" BorderThickness="1" CornerRadius="3"
            Padding="8,4" Background="#1a1a2e">
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <Button x:Name="StartButton" Content="Start Combat" Click="OnStartClick"
                Width="110" Height="22" FontSize="11" Foreground="White" BorderThickness="1" />
        <Button x:Name="NextButton" Content="Next" Click="OnNextClick"
                Width="70" Height="22" FontSize="11" IsEnabled="False"
                Foreground="White" BorderThickness="1" />
        <Button x:Name="AutoButton" Content="Auto Play" Click="OnAutoClick"
                Width="70" Height="22" FontSize="11" IsEnabled="False"
                Foreground="White" BorderThickness="1" />
        <TextBlock Text="Speed:" Foreground="#888" VerticalAlignment="Center" FontSize="12" />
        <Slider x:Name="SpeedSlider" Width="90" Minimum="0.1" Maximum="3"
                Value="1" TickFrequency="0.5" IsSnapToTickEnabled="True"
                VerticalAlignment="Center" ValueChanged="OnSpeedChanged" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
