<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:BattleArena.Gui.Views"
        x:Class="BattleArena.Gui.Views.MainWindow"
        Title="BattleArena — Combat Simulation"
        MinWidth="900" MinHeight="600"
        WindowState="Maximized"
        Background="#0d0d1a">
  <Window.Resources>
    <views:DoubleToWidthConverter x:Key="WidthConv" />
    <views:DoubleToGridLengthConverter x:Key="GridLenConv" />
    <views:StepStateConverter x:Key="StepBg" Mode="Bg" />
    <views:StepStateConverter x:Key="StepBorder" Mode="Border" />
    <views:StepStateConverter x:Key="StepFg" Mode="Fg" />
    <views:StepStateConverter x:Key="StepLabel" Mode="Label" />
    <views:StepStateConverter x:Key="StepText" Mode="Text" />
    <views:NotNullConverter x:Key="NotNullConverter" />
    <views:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter" />
    <views:SelectedButtonConverter x:Key="SelectedButtonConverter" />
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Background" Value="#3a3a5c" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#555" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover">
      <Setter Property="Background" Value="#00bfff" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#00bfff" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button:pressed">
      <Setter Property="Background" Value="#0088cc" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#0088cc" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Background" Value="#1a1a2e" />
      <Setter Property="Foreground" Value="#555" />
      <Setter Property="BorderBrush" Value="#333" />
    </Style>
    <Style Selector="Button:disabled /template/ ContentPresenter">
      <Setter Property="Foreground" Value="#555" />
    </Style>

    <!-- Toggle buttons: disabled state = "selected/active" appearance -->
    <Style Selector="Button.toggle:disabled">
      <Setter Property="Background" Value="#00bfff" />
      <Setter Property="Foreground" Value="#0d0d1a" />
      <Setter Property="BorderBrush" Value="#00dfff" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.toggle:disabled /template/ ContentPresenter">
      <Setter Property="Background" Value="#00bfff" />
      <Setter Property="Foreground" Value="#0d0d1a" />
    </Style>

    <!-- Compact combat-log list items: strip Fluent default padding/min-height -->
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0,0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0a1a2e" />
    </Style>
  </Window.Styles>

  <Grid Margin="8">

    <!-- ── MAIN MENU PHASE ── -->
    <Grid IsVisible="{Binding IsMainMenuPhase}" RowDefinitions="*,Auto,Auto,*" Margin="20">
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <TextBlock Text="BATTLE ARENA"
                   Foreground="#00bfff" FontSize="36" FontWeight="Bold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Choose Mode"
                   Foreground="#888" FontSize="16"
                   HorizontalAlignment="Center" Margin="0,0,0,20" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="24">
          <Button x:Name="DemoButton" Content="DEMO" Click="OnDemoClick"
                  Width="180" Height="60" FontSize="20" />
          <StackPanel VerticalAlignment="Center" Spacing="4">
            <Button x:Name="ApiModeButton" Content="API VERSION" Click="OnApiModeClick"
                    Width="180" Height="60" FontSize="20"
                    IsEnabled="{Binding IsApiReachable}" />
            <TextBlock Text="API is unreachable" Foreground="#ff6644" FontSize="11"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding IsApiUnreachable}" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ── COMBAT PHASE ── -->
    <Grid IsVisible="{Binding IsCombatPhase}" RowDefinitions="Auto,Auto,*,220,Auto">

      <!-- Row 0: Title -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,4">
        <TextBlock Grid.Column="0" Text="***  BATTLE ARENA  —  COMBAT SIMULATION  ***"
                   Foreground="#00bfff" FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center" />
        <Border Grid.Column="1" Background="#6a3a8a" CornerRadius="3" Padding="6,2"
                BorderBrush="#8a5aaa" BorderThickness="1"
                VerticalAlignment="Center" IsVisible="{Binding IsApiMode}">
          <TextBlock Text="API MODE" Foreground="#e0d0f0" FontSize="10" FontWeight="Bold" />
        </Border>
      </Grid>

      <!-- Row 1: Round progress bar -->
      <Border Grid.Row="1" BorderBrush="#333" BorderThickness="1" CornerRadius="3"
              Background="#0d0d1a" Height="28" Margin="0,0,0,2">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding RoundProgress, Converter={StaticResource GridLenConv}}" />
            <ColumnDefinition Width="{Binding RoundRemainder, Converter={StaticResource GridLenConv}}" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" CornerRadius="2">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#001a33" Offset="0.0" />
                <GradientStop Color="#3399ff" Offset="1.0" />
              </LinearGradientBrush>
            </Border.Background>
          </Border>
          <Border Grid.Column="1" Background="#0a0a1a" />
          <TextBlock Grid.ColumnSpan="2" Text="{Binding RoundBarHeader}"
                     Foreground="White" FontSize="13" FontWeight="Bold"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Border>

      <!-- Row 2: Character cards side by side -->
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto,*" Margin="0,4">
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Heroes}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <views:CharacterCard DataContext="{Binding}" Margin="2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <Border Grid.Column="1" Width="3" Background="#333" Margin="8,0" />

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Enemies}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="4" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <views:CharacterCard DataContext="{Binding}" Margin="2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <!-- Row 3: Combat log -->
      <Border Grid.Row="3" BorderBrush="#333" BorderThickness="1" CornerRadius="3"
              Background="#0a0a1a" Margin="0,4">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="6,2">
            <TextBlock Grid.Column="0" Text="COMBAT LOG" Foreground="#888" FontSize="11"
                       FontWeight="Bold" VerticalAlignment="Center" />
            <Button Grid.Column="1" x:Name="CopyLogButton" Content="Copy" Click="OnCopyLogClick"
                    Width="50" Height="20" FontSize="10" Padding="4,0"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          </Grid>
          <ListBox x:Name="CombatLogListBox" Grid.Row="1" ItemsSource="{Binding CombatLog}"
                   Background="Transparent" BorderThickness="0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <ItemsControl ItemsSource="{Binding Segments}"
                              Margin="4,0">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                                 FontSize="12" TextWrapping="NoWrap" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <!-- Row 4: Control bar -->
      <Border Grid.Row="4" BorderBrush="#333" BorderThickness="1" CornerRadius="3"
              Padding="8,4" Background="#1a1a2e">
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
          <Button x:Name="StartButton" Content="Back to Setup" Click="OnBackToSetupClick"
                  Width="110" Height="28" FontSize="11"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          <Button x:Name="NextButton" Content="Next Turn" Click="OnNextClick"
                  Width="70" Height="28" FontSize="11" IsEnabled="False"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          <Button x:Name="AutoButton" Content="Auto Play" Click="OnAutoClick"
                  Width="70" Height="28" FontSize="11" IsEnabled="False"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
          <Separator Width="1" Background="#444" Margin="4,0" />
          <Button x:Name="NewCombatButton" Content="New Combat" Click="OnNewCombatClick"
                  Width="100" Height="28" FontSize="11" IsVisible="False"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                  Background="#3a5c3a" BorderBrush="#575" />
          <TextBlock Text="Speed:" Foreground="#999" VerticalAlignment="Center" FontSize="12" />
          <Slider x:Name="SpeedSlider" Width="120" Minimum="0" Maximum="2"
                  Value="1" TickFrequency="1" IsSnapToTickEnabled="True"
                  VerticalAlignment="Center" ValueChanged="OnSpeedChanged" />
          <TextBlock x:Name="SpeedLabel" Text="Normal" Foreground="#88bbff" FontSize="12"
                     FontWeight="Bold" VerticalAlignment="Center" Width="60"
                     TextAlignment="Center" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- ── SETUP PHASE ── -->
    <Grid IsVisible="{Binding IsSetupPhase}" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto" Margin="20">

      <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,10">
        <TextBlock Text="CHOOSE YOUR CHAMPIONS" Foreground="#00bfff" FontSize="20" FontWeight="Bold" />
        <Border Background="#6a3a8a" CornerRadius="3" Padding="5,1"
                BorderBrush="#8a5aaa" BorderThickness="1"
                VerticalAlignment="Center" IsVisible="{Binding IsApiMode}">
          <TextBlock Text="API MODE" Foreground="#e0d0f0" FontSize="9" FontWeight="Bold" />
        </Border>
      </StackPanel>

      <!-- Scenario toggle -->
      <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="0,0,0,8">
        <Button x:Name="DuelButton" Classes="toggle" Content="Duel" Click="OnDuelClick"
                Width="110" Height="30" FontSize="12" />
        <Button x:Name="ClashButton" Classes="toggle" Content="Clash" Click="OnClashClick"
                Width="110" Height="30" FontSize="12" />
      </StackPanel>

      <!-- Mode toggle -->
      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="0,0,0,4">
        <Button x:Name="TurnBasedButton" Classes="toggle" Content="Turn-based" Click="OnTurnBasedClick"
                Width="110" Height="28" FontSize="11" />
        <Button x:Name="AutoModeButton" Classes="toggle" Content="Auto" Click="OnAutoModeClick"
                Width="100" Height="28" FontSize="11" />
      </StackPanel>

      <!-- Selection hint -->
      <TextBlock x:Name="SelectionHint" Grid.Row="3" Foreground="#888" FontSize="13"
                 HorizontalAlignment="Center" Margin="0,4" />

      <!-- Hero roster -->
      <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" Margin="0,4">
        <ListBox x:Name="HeroListBox" Background="Transparent" BorderThickness="0"
                 SelectionMode="Single" SelectionChanged="OnHeroSelected">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Background="#1a1a2e"
                      BorderBrush="{Binding BorderBrush}"
                      BorderThickness="{Binding BorderThickness}"
                      CornerRadius="6" Padding="0" Margin="6" Width="260">
                <Grid>
                  <!-- Card content -->
                  <Grid ColumnDefinitions="80,*">
                    <Border Grid.Column="0" Width="80" Height="107"
                            CornerRadius="6,0,0,6" ClipToBounds="True"
                            Background="#0d0d1a">
                      <Image Source="{Binding Portrait}" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,8" VerticalAlignment="Center" Spacing="3">
                      <TextBlock Text="{Binding Name}" Foreground="#88bbff" FontSize="14"
                                 FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Foreground="#aaa" FontSize="11">
                        <Run Text="{Binding ClassName}" />
                      </TextBlock>
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Foreground="#777" FontSize="11">
                          <Run Text="Lv " /><Run Text="{Binding Level}" />
                        </TextBlock>
                        <TextBlock Foreground="#777" FontSize="11"
                                   Text="{Binding RaceName}" />
                      </StackPanel>
                      <TextBlock Foreground="#777" FontSize="10">
                        <Run Text="HP " /><Run Foreground="#44cc44" Text="{Binding MaxHitPoints}" />
                      </TextBlock>
                    </StackPanel>
                  </Grid>
                  <!-- Selection badge at top center -->
                  <Border VerticalAlignment="Top" HorizontalAlignment="Center"
                          Background="{Binding SelectionBadgeColor}" CornerRadius="0,0,4,4"
                          Padding="12,3" IsVisible="{Binding IsSelected}" Opacity="0.95">
                    <TextBlock Text="{Binding SelectionLabel}" Foreground="White" FontSize="10"
                               FontWeight="Bold" />
                  </Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>

      <!-- Proceed / Back -->
      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" Margin="0,4">
        <Button x:Name="ProceedButton" Content="PROCEED" Click="OnFightClick"
                Width="180" Height="36" FontSize="15"
                Background="#2a6a2a" BorderBrush="#4a9a4a"
                IsEnabled="{Binding CanProceed}" />
        <Button x:Name="BackToMainFromSetupButton" Content="Back to Main Menu" Click="OnBackToMainFromSetupClick"
                Width="140" Height="36" FontSize="11" Background="#5c3a3a" BorderBrush="#755" />
      </StackPanel>
    </Grid>

    <!-- ── API MENU PHASE ── -->
    <Grid IsVisible="{Binding IsApiMenuPhase}" RowDefinitions="*,Auto,*" Margin="20">
      <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="API VERSION"
                   Foreground="#00bfff" FontSize="28" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0,0,0,16" />
        <Button x:Name="CreateCharButton" Content="Create Character"
                Width="220" Height="44" FontSize="15" Click="OnCreateCharClick" />
        <Button x:Name="VsButton" Content="Duel"
                Width="220" Height="44" FontSize="15" Click="OnVsClick" />
        <Button x:Name="PartyVsPartyButton" Content="Clash"
                Width="220" Height="44" FontSize="15" Click="OnPartyVsPartyClick" />
        <Button x:Name="BackToMainButton" Content="Back"
                Width="220" Height="44" FontSize="15" Click="OnBackToMainClick"
                Background="#5c3a3a" BorderBrush="#755" />
      </StackPanel>
    </Grid>

    <!-- ── CHARACTER CREATION PHASE ── -->
    <Grid IsVisible="{Binding IsCharCreationPhase}" Margin="20">
      <Border Background="#12121e" CornerRadius="8" Padding="20" MinWidth="640" MaxWidth="760"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

          <!-- Row 0: Title -->
          <TextBlock Grid.Row="0" Text="CHARACTER CREATION"
                     Foreground="#00bfff" FontSize="20" FontWeight="Bold"
                     HorizontalAlignment="Center" Margin="0,0,0,12" />

          <!-- Row 1: Linear step indicator -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center"
                      Spacing="0" Margin="0,0,0,16">
            <!-- Step 0: Class -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="28" Height="28" CornerRadius="14"
                      Background="{Binding CreationStep, Converter={StaticResource StepBg}, ConverterParameter=0}"
                      BorderBrush="{Binding CreationStep, Converter={StaticResource StepBorder}, ConverterParameter=0}"
                      BorderThickness="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding CreationStep, Converter={StaticResource StepText}, ConverterParameter=0}"
                           Foreground="{Binding CreationStep, Converter={StaticResource StepFg}, ConverterParameter=0}"
                           FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Class"
                         Foreground="{Binding CreationStep, Converter={StaticResource StepLabel}, ConverterParameter=0}"
                         FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="  →  " Foreground="#555" FontSize="12" VerticalAlignment="Center" />
            <!-- Step 1: Race -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="28" Height="28" CornerRadius="14"
                      Background="{Binding CreationStep, Converter={StaticResource StepBg}, ConverterParameter=1}"
                      BorderBrush="{Binding CreationStep, Converter={StaticResource StepBorder}, ConverterParameter=1}"
                      BorderThickness="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding CreationStep, Converter={StaticResource StepText}, ConverterParameter=1}"
                           Foreground="{Binding CreationStep, Converter={StaticResource StepFg}, ConverterParameter=1}"
                           FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Race"
                         Foreground="{Binding CreationStep, Converter={StaticResource StepLabel}, ConverterParameter=1}"
                         FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="  →  " Foreground="#555" FontSize="12" VerticalAlignment="Center" />
            <!-- Step 2: Subrace -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="28" Height="28" CornerRadius="14"
                      Background="{Binding CreationStep, Converter={StaticResource StepBg}, ConverterParameter=2}"
                      BorderBrush="{Binding CreationStep, Converter={StaticResource StepBorder}, ConverterParameter=2}"
                      BorderThickness="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding CreationStep, Converter={StaticResource StepText}, ConverterParameter=2}"
                           Foreground="{Binding CreationStep, Converter={StaticResource StepFg}, ConverterParameter=2}"
                           FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Subrace"
                         Foreground="{Binding CreationStep, Converter={StaticResource StepLabel}, ConverterParameter=2}"
                         FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="  →  " Foreground="#555" FontSize="12" VerticalAlignment="Center" />
            <!-- Step 3: Stats -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="28" Height="28" CornerRadius="14"
                      Background="{Binding CreationStep, Converter={StaticResource StepBg}, ConverterParameter=3}"
                      BorderBrush="{Binding CreationStep, Converter={StaticResource StepBorder}, ConverterParameter=3}"
                      BorderThickness="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding CreationStep, Converter={StaticResource StepText}, ConverterParameter=3}"
                           Foreground="{Binding CreationStep, Converter={StaticResource StepFg}, ConverterParameter=3}"
                           FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Stats"
                         Foreground="{Binding CreationStep, Converter={StaticResource StepLabel}, ConverterParameter=3}"
                         FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="  →  " Foreground="#555" FontSize="12" VerticalAlignment="Center" />
            <!-- Step 4: Name -->
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Border Width="28" Height="28" CornerRadius="14"
                      Background="{Binding CreationStep, Converter={StaticResource StepBg}, ConverterParameter=4}"
                      BorderBrush="{Binding CreationStep, Converter={StaticResource StepBorder}, ConverterParameter=4}"
                      BorderThickness="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding CreationStep, Converter={StaticResource StepText}, ConverterParameter=4}"
                           Foreground="{Binding CreationStep, Converter={StaticResource StepFg}, ConverterParameter=4}"
                           FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock Text="Name"
                         Foreground="{Binding CreationStep, Converter={StaticResource StepLabel}, ConverterParameter=4}"
                         FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>

          <!-- Row 2: Step content (fills remaining space, scrolls if needed) -->
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowDefinitions="*,Auto">

              <!-- ═══ Step 0: Class ═══ -->
              <StackPanel IsVisible="{Binding IsStepClass}" HorizontalAlignment="Center"
                          VerticalAlignment="Top" Spacing="8" Margin="0,8">
                <TextBlock Text="Choose your class"
                         Foreground="#88bbff" FontSize="14" FontWeight="Bold"
                         HorizontalAlignment="Center" />
              <ItemsControl ItemsSource="{Binding AvailableClasses}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel MaxWidth="420" HorizontalAlignment="Center" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding}" Width="130" Height="34" Margin="4"
                            FontSize="12" Click="OnClassButtonClick"
                            BorderBrush="#555" BorderThickness="1">
                      <Button.Background>
                        <MultiBinding Converter="{StaticResource SelectedButtonConverter}">
                          <Binding Path="." />
                          <Binding Path="DataContext.SelectedClassName" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                      </Button.Background>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Class info panel -->
              <Border Background="#0d0d18" CornerRadius="4" Padding="12,8"
                      BorderBrush="#333" BorderThickness="1" Margin="0,4,0,0"
                      IsVisible="{Binding SelectedClassName, Converter={StaticResource NotNullConverter}}"
                      Width="450" Height="110" MinHeight="110" HorizontalAlignment="Left">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="80" Height="80" Background="#1a1a2e" BorderBrush="#444"
                          BorderThickness="1" CornerRadius="4" Margin="0,0,10,0"
                          VerticalAlignment="Top">
                    <TextBlock Text="🖼" Foreground="#444" FontSize="28"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding SelectedClassFullInfo}" Foreground="#bbb"
                               FontSize="12" TextWrapping="Wrap" />
                  </ScrollViewer>
                </Grid>
              </Border>

              <!-- School selection (for Mage) -->
              <StackPanel IsVisible="{Binding IsMageSelected}" Spacing="6"
                          Margin="0,4,0,0">
                <TextBlock Text="Choose a school of magic"
                           Foreground="#d4a017" FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding AvailableSchools}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel MaxWidth="420" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding}" Width="140" Height="30" Margin="4"
                              FontSize="11" Click="OnSchoolButtonClick"
                              BorderBrush="#886622" BorderThickness="1">
                        <Button.Background>
                          <MultiBinding Converter="{StaticResource SelectedButtonConverter}" ConverterParameter="#2a2a3e">
                            <Binding Path="." />
                            <Binding Path="DataContext.SelectedSchool" RelativeSource="{RelativeSource AncestorType=Window}" />
                          </MultiBinding>
                        </Button.Background>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding SelectedSchool, StringFormat='School: {0}'}"
                           Foreground="#d4a017" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <!-- School info panel -->
                <Border Background="#0d0d18" CornerRadius="4" Padding="12,8"
                        BorderBrush="#333" BorderThickness="1" Margin="0,4,0,0"
                        IsVisible="{Binding SelectedSchool, Converter={StaticResource NotNullConverter}}"
                        Width="450" Height="110" MinHeight="110" HorizontalAlignment="Left">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Width="80" Height="80" Background="#1a1a2e" BorderBrush="#444"
                            BorderThickness="1" CornerRadius="4" Margin="0,0,10,0"
                            VerticalAlignment="Top">
                      <TextBlock Text="🖼" Foreground="#444" FontSize="28"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <TextBlock Text="{Binding SelectedSchoolInfo}" Foreground="#bbb"
                                 FontSize="12" TextWrapping="Wrap" />
                    </ScrollViewer>
                  </Grid>
                </Border>
              </StackPanel>

              <!-- Deity selection (for Priest) -->
              <StackPanel IsVisible="{Binding IsPriestSelected}" Spacing="6"
                          Margin="0,4,0,0">
                <TextBlock Text="Choose your deity"
                           Foreground="#a0c0ff" FontSize="13" FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding AvailableDeities}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel MaxWidth="420" HorizontalAlignment="Center" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding}" Width="140" Height="30" Margin="4"
                              FontSize="11" Click="OnDeityButtonClick"
                              BorderBrush="#5588aa" BorderThickness="1">
                        <Button.Background>
                          <MultiBinding Converter="{StaticResource SelectedButtonConverter}" ConverterParameter="#2a2a3e">
                            <Binding Path="." />
                            <Binding Path="DataContext.SelectedDeity" RelativeSource="{RelativeSource AncestorType=Window}" />
                          </MultiBinding>
                        </Button.Background>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Deity info -->
                <Border Background="#0d0d18" CornerRadius="4" Padding="12,8"
                        BorderBrush="#333" BorderThickness="1" Margin="0,4,0,0"
                        IsVisible="{Binding SelectedDeity, Converter={StaticResource NotNullConverter}}"
                        Width="450" Height="110" MinHeight="110" HorizontalAlignment="Left">
                  <Grid ColumnDefinitions="Auto,*">
                    <Border Width="80" Height="80" Background="#1a1a2e" BorderBrush="#444"
                            BorderThickness="1" CornerRadius="4" Margin="0,0,10,0"
                            VerticalAlignment="Top">
                      <TextBlock Text="🖼" Foreground="#444" FontSize="28"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                      <TextBlock Text="{Binding SelectedDeityInfo}" Foreground="#bbb"
                                 FontSize="12" TextWrapping="Wrap" />
                    </ScrollViewer>
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>

            <!-- ═══ Step 1: Race ═══ -->
            <StackPanel IsVisible="{Binding IsStepRace}" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Spacing="8" Margin="0,8">
              <TextBlock Text="Choose your race"
                         Foreground="#88bbff" FontSize="14" FontWeight="Bold"
                         HorizontalAlignment="Center" />
              <ItemsControl ItemsSource="{Binding AvailableRaces}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel MaxWidth="560" HorizontalAlignment="Center" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding}" Width="120" Height="34" Margin="4"
                            FontSize="12" Click="OnRaceButtonClick"
                            BorderBrush="#555" BorderThickness="1">
                      <Button.Background>
                        <MultiBinding Converter="{StaticResource SelectedButtonConverter}">
                          <Binding Path="." />
                          <Binding Path="DataContext.SelectedRaceName" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                      </Button.Background>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Race info panel -->
              <Border Background="#0d0d18" CornerRadius="4" Padding="12,8"
                      BorderBrush="#333" BorderThickness="1" Margin="0,4,0,0"
                      IsVisible="{Binding SelectedRaceName, Converter={StaticResource NotNullConverter}}"
                      Width="450" Height="110" MinHeight="110" HorizontalAlignment="Left">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="80" Height="80" Background="#1a1a2e" BorderBrush="#444"
                          BorderThickness="1" CornerRadius="4" Margin="0,0,10,0"
                          VerticalAlignment="Top">
                    <TextBlock Text="🖼" Foreground="#444" FontSize="28"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding SelectedRaceFullInfo}" Foreground="#bbb"
                               FontSize="12" TextWrapping="Wrap" />
                  </ScrollViewer>
                </Grid>
              </Border>
            </StackPanel>

            <!-- ═══ Step 2: Subrace ═══ -->
            <StackPanel IsVisible="{Binding IsStepSubrace}" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Spacing="8" Margin="0,8">
              <TextBlock Text="Choose a subrace"
                         Foreground="#88bbff" FontSize="14" FontWeight="Bold"
                         HorizontalAlignment="Center" />
              <ItemsControl ItemsSource="{Binding AvailableSubraces}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel MaxWidth="560" HorizontalAlignment="Center" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Content="{Binding}" Width="130" Height="32" Margin="4"
                            FontSize="11" Click="OnSubraceButtonClick"
                            BorderBrush="#555" BorderThickness="1">
                      <Button.Background>
                        <MultiBinding Converter="{StaticResource SelectedButtonConverter}">
                          <Binding Path="." />
                          <Binding Path="DataContext.SelectedSubraceName" RelativeSource="{RelativeSource AncestorType=Window}" />
                        </MultiBinding>
                      </Button.Background>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Subrace info panel -->
              <Border Background="#0d0d18" CornerRadius="4" Padding="12,8"
                      BorderBrush="#333" BorderThickness="1" Margin="0,4,0,0"
                      IsVisible="{Binding SelectedSubraceName, Converter={StaticResource NotNullConverter}}"
                      Width="450" Height="110" MinHeight="110" HorizontalAlignment="Left">
                <Grid ColumnDefinitions="Auto,*">
                  <Border Width="80" Height="80" Background="#1a1a2e" BorderBrush="#444"
                          BorderThickness="1" CornerRadius="4" Margin="0,0,10,0"
                          VerticalAlignment="Top">
                    <TextBlock Text="🖼" Foreground="#444" FontSize="28"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Text="{Binding SelectedSubraceFullInfo}" Foreground="#bbb"
                               FontSize="12" TextWrapping="Wrap" />
                  </ScrollViewer>
                </Grid>
              </Border>
            </StackPanel>

            <!-- ═══ Step 3: Stats ═══ -->
            <StackPanel IsVisible="{Binding IsStepStats}" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Spacing="10" Margin="0,8">
              <TextBlock Text="Ability Scores"
                         Foreground="#88bbff" FontSize="14" FontWeight="Bold"
                         HorizontalAlignment="Center" />

              <!-- Stat cards row -->
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Background="#1a1a2e" BorderBrush="#444" BorderThickness="1"
                        CornerRadius="4" Padding="12,6" Margin="4" Width="90">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="STR" Foreground="#88bbff" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CharStrDisplay}" Foreground="White" FontSize="20"
                               FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CharStrMod}" Foreground="#888" FontSize="11"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Background="#1a1a2e" BorderBrush="#444" BorderThickness="1"
                        CornerRadius="4" Padding="12,6" Margin="4" Width="90">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="DEX" Foreground="#88bbff" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CharDex}" Foreground="White" FontSize="20"
                               FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CharDexMod}" Foreground="#888" FontSize="11"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Background="#1a1a2e" BorderBrush="#444" BorderThickness="1"
                        CornerRadius="4" Padding="12,6" Margin="4" Width="90">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="STA" Foreground="#88bbff" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CharSta}" Foreground="White" FontSize="20"
                               FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CharStaMod}" Foreground="#888" FontSize="11"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Background="#1a1a2e" BorderBrush="#444" BorderThickness="1"
                        CornerRadius="4" Padding="12,6" Margin="4" Width="90">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="INT" Foreground="#88bbff" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CharInt}" Foreground="White" FontSize="20"
                               FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CharIntMod}" Foreground="#888" FontSize="11"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Background="#1a1a2e" BorderBrush="#444" BorderThickness="1"
                        CornerRadius="4" Padding="12,6" Margin="4" Width="90">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="WIS" Foreground="#88bbff" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CharWis}" Foreground="White" FontSize="20"
                               FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CharWisMod}" Foreground="#888" FontSize="11"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
                <Border Background="#1a1a2e" BorderBrush="#444" BorderThickness="1"
                        CornerRadius="4" Padding="12,6" Margin="4" Width="90">
                  <StackPanel HorizontalAlignment="Center" Spacing="2">
                    <TextBlock Text="CHA" Foreground="#88bbff" FontSize="10" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CharCha}" Foreground="White" FontSize="20"
                               FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CharChaMod}" Foreground="#888" FontSize="11"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
              </StackPanel>

              <!-- Roll button + exceptional strength -->
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="14" Margin="0,4">
                <Button x:Name="RollStatsButton" Content="Roll Stats (4d6 drop lowest)"
                        Click="OnRollStatsClick" Width="200" Height="32" FontSize="12" />
                <Button x:Name="RerollStatsButton" Content="Reroll" Click="OnRollStatsClick"
                        Width="90" Height="32" FontSize="12"
                        Background="#3a3a5c" BorderBrush="#575" />
              </StackPanel>

              <!-- Character summary preview -->
              <Border Background="#0d0d18" CornerRadius="4" Padding="14,8"
                      BorderBrush="#333" BorderThickness="1" Margin="0,4,0,0">
                <StackPanel HorizontalAlignment="Center" Spacing="2">
                  <TextBlock Text="{Binding CharCreationSummary}" Foreground="#aaa" FontSize="12"
                             HorizontalAlignment="Center" />
                  <TextBlock x:Name="ExcStrLabel2" Text="" Foreground="#d4a017" FontSize="12"
                             FontWeight="Bold" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ═══ Step 4: Name ═══ -->
            <StackPanel IsVisible="{Binding IsStepName}" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Spacing="10" Margin="0,8">
              <TextBlock Text="What is your character's name?"
                         Foreground="#ccc" FontSize="14" HorizontalAlignment="Center" />
              <TextBox x:Name="CharNameBox" Text="{Binding CharName}" Width="220" Height="28"
                       FontSize="13" Background="#1a1a2e" Foreground="White"
                       BorderBrush="#555" BorderThickness="1"
                       HorizontalAlignment="Center" TextChanged="OnCharNameChanged" />
            </StackPanel>

            <!-- ═══ Fishbone visualization of selections ═══ -->
            <Border Grid.Row="1" Background="#0a0a14" CornerRadius="4" Padding="12,6"
                    BorderBrush="#2a2a3e" BorderThickness="1" Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Class node -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0"
                            IsVisible="{Binding SelectedClassName, Converter={StaticResource NotNullConverter}}">
                  <Border Width="10" Height="10" CornerRadius="5"
                          Background="{Binding CreationStep, Converter={StaticResource StepBg}, ConverterParameter=0}"
                          VerticalAlignment="Center" />
                  <TextBlock Foreground="#88bbff" FontSize="11" FontWeight="Bold"
                             VerticalAlignment="Center">
                    <Run Text="Class: " /><Run Text="{Binding SelectedClass}" />
                  </TextBlock>
                  <!-- School/Deity branch -->
                  <TextBlock Foreground="#d4a017" FontSize="11" FontWeight="Bold"
                             VerticalAlignment="Center"
                             IsVisible="{Binding SelectedSchool, Converter={StaticResource NotNullConverter}}">
                    <Run Text="→ School: " /><Run Text="{Binding SelectedSchool}" />
                  </TextBlock>
                  <TextBlock Foreground="#a0c0ff" FontSize="11" FontWeight="Bold"
                             VerticalAlignment="Center"
                             IsVisible="{Binding SelectedDeity, Converter={StaticResource NotNullConverter}}">
                    <Run Text="→ Deity: " /><Run Text="{Binding SelectedDeity}" />
                  </TextBlock>
                </StackPanel>

                <!-- Race node -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0"
                            IsVisible="{Binding SelectedRaceName, Converter={StaticResource NotNullConverter}}">
                  <Border Width="10" Height="10" CornerRadius="5"
                          Background="{Binding CreationStep, Converter={StaticResource StepBg}, ConverterParameter=1}"
                          VerticalAlignment="Center" />
                  <TextBlock Foreground="#88bbff" FontSize="11" FontWeight="Bold"
                             VerticalAlignment="Center">
                    <Run Text="Race: " /><Run Text="{Binding SelectedRace}" />
                  </TextBlock>
                  <!-- Subrace branch -->
                  <TextBlock Foreground="#88bbff" FontSize="11" FontWeight="Bold"
                             VerticalAlignment="Center"
                             IsVisible="{Binding SelectedSubraceName, Converter={StaticResource NotNullConverter}}">
                    <Run Text="→ " /><Run Text="{Binding SelectedSubrace}" />
                  </TextBlock>
                </StackPanel>

                <!-- Stats node -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0"
                            IsVisible="{Binding CharStr, Converter={StaticResource GreaterThanZeroConverter}}">
                  <Border Width="10" Height="10" CornerRadius="5"
                          Background="{Binding CreationStep, Converter={StaticResource StepBg}, ConverterParameter=3}"
                          VerticalAlignment="Center" />
                  <TextBlock Foreground="#88bbff" FontSize="11" FontWeight="Bold"
                             VerticalAlignment="Center"
                             Text="Stats: rolled" />
                </StackPanel>

                <!-- Name node -->
                <StackPanel Orientation="Horizontal" Spacing="4" Margin="10,0"
                            IsVisible="{Binding IsStepName}">
                  <Border Width="10" Height="10" CornerRadius="5"
                          Background="{Binding CreationStep, Converter={StaticResource StepBg}, ConverterParameter=4}"
                          VerticalAlignment="Center" />
                  <TextBlock Text="Name: " FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                             Foreground="#88bbff" />
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
            </ScrollViewer>

          <!-- Row 3: Navigation buttons -->
          <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center"
                      Spacing="16" Margin="0,16,0,0">
            <Button x:Name="BackStepButton" Content="← Back"
                    Click="OnBackStepClick" Width="100" Height="30" FontSize="12"
                    IsEnabled="{Binding CanGoBack}"
                    Background="#5c3a3a" BorderBrush="#755" />
            <Button x:Name="NextStepButton" Content="Next →"
                    Click="OnNextStepClick" Width="100" Height="30" FontSize="12"
                    IsEnabled="{Binding CanGoNext}"
                    IsVisible="{Binding ShowNextButton}" />
            <Button x:Name="CreateCharFinishButton" Content="Create Character"
                    Click="OnCreateCharFinishClick" Width="140" Height="30" FontSize="12"
                    IsEnabled="{Binding CanCreate}"
                    IsVisible="{Binding IsStepName}" />
          </StackPanel>

          <!-- Row 4: Bottom actions -->
          <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center"
                      Spacing="16" Margin="0,4,0,0">
            <Button x:Name="BackToMainFromCharCreationButton" Content="Back to Main Menu"
                    Click="OnBackToMainClick" Width="160" Height="30" FontSize="11"
                    Background="#5c3a3a" BorderBrush="#755" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
