<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BattleArena.Gui.Views.World.WorldView"
             Background="#0a0a14">
  <Grid RowDefinitions="*,Auto">
    <Border Grid.Row="0" x:Name="MapClipRegion" ClipToBounds="True" Background="#0a0a14"
            PointerPressed="OnMapPointerPressed"
            PointerMoved="OnMapPointerMoved"
            PointerReleased="OnMapPointerReleased"
            PointerWheelChanged="OnMapPointerWheelChanged">
      <Canvas x:Name="MapCanvas" Background="Transparent" />
    </Border>
    <Border Grid.Row="1" Background="#0d0d18" BorderBrush="#1a1a2e" BorderThickness="0,1,0,0" Padding="8,3">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock x:Name="ZoneNameText" Text=""
                     Foreground="#d4a017" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
          <TextBlock Text="·" Foreground="#444" FontSize="10" VerticalAlignment="Center" />
          <TextBlock x:Name="TerrainText" Text="{Binding TerrainName}"
                     Foreground="#888" FontSize="10" VerticalAlignment="Center" />
          <TextBlock Text="·" Foreground="#444" FontSize="10" VerticalAlignment="Center" />
          <TextBlock x:Name="HelpText"
                     Text="Drag to pan · Scroll to zoom"
                     Foreground="#666" FontSize="10" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="2" x:Name="TileInfoText"
                   Text="" Foreground="#555" FontSize="10" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
